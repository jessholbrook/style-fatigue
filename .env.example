# Postgres as reached from the host (docker-compose overrides this for the backend container)
DATABASE_URL=postgresql://stylefatigue:stylefatigue@localhost:5432/stylefatigue
ANTHROPIC_API_KEY=sk-ant-...
# Also seeds the blocked-randomization permutations — set a real secret before enrolling participants
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
# Defaults to <repo>/experiment; only set this if the config lives elsewhere
# EXPERIMENT_CONFIG_PATH=/experiment
